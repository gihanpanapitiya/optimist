# API keys are also read from ../literature/.env, so you only need them once.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Main agent model ("provider:model", anything init_chat_model understands).
FOREST_MODEL=openai:gpt-5.4
# Model for spawned subagents (defaults to FOREST_MODEL).
# FOREST_SUBAGENT_MODEL=openai:gpt-5.4-mini

# Where deep research corpora and other artifacts are written.
# FOREST_WORKSPACE=./workspace

# Shell commands and deletions pause for approval unless this is set.
# Commands run as your user with the workspace as working directory.
# FOREST_AUTO_APPROVE=1
